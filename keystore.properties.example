# Copiar como keystore.properties (ignorado por Git) y completar localmente.
# Alternativa sin archivo: scripts/generar-apk-firmado.ps1 usa variables de entorno
# (CORPALIV_STORE_FILE, CORPALIV_STORE_PASSWORD, CORPALIV_KEY_ALIAS, CORPALIV_KEY_PASSWORD) solo en la sesión.
# Usar / en rutas de Windows. La ruta puede ser absoluta o relativa a la raíz.
# Ubicación del almacén privado que contiene el certificado y la clave.
storeFile=C:/ruta/privada/corpaliv-release.jks
# Contraseña que abre el almacén .jks.
storePassword=COMPLETAR_LOCALMENTE
# Nombre de la entrada de clave que debe seleccionar Gradle.
keyAlias=corpaliv-release
# Contraseña que permite usar esa clave para firmar el APK.
keyPassword=COMPLETAR_LOCALMENTE
